### Local environment overrides (template)
# W&B settings
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=LeJEPA-base
WANDB_GROUP=experiment-group-name
WANDB_MODE=online

# Hydra settings
HYDRA_FULL_ERROR=1

# Dataset/cache paths
# On MCML, keep dataset caches on shared scratch so login and compute nodes see
# the same files. GeoDRO v1 launchers use GEODRO_DATASET_ROOT plus per-dataset
# cache directories created by scripts/slurm/download_datasets.sbatch.
MCMLSCRATCH=/dss/mcmlscratch/<project>/<user>
GEODRO_DATASET_ROOT=/dss/mcmlscratch/<project>/<user>/datasets/geodro_v1
GEODRO_HF_HOME=/dss/mcmlscratch/<project>/<user>/datasets/geodro_v1/hf_home
